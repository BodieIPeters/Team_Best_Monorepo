{
  "name": "monopoly-server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --testPathIgnorePatterns=integration",
    "test:integration": "(cd .. && supabase start && supabase db reset) && jest --testPathPatterns=integration --runInBand"
  },
  "jest": {
  "testEnvironment": "node",
  "testMatch": [
    "**/__tests__/**/*.test.js",
    "**/tests/**/*.test.js"
  ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "keywords": [],
